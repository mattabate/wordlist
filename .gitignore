# Python-specific ignores
__pycache__/
*.pyc
pyproject.toml

# Environment files
.env

# Poetry files
poetry.lock

# *.db
*db
*.db-journal

# Trained models, anywhere — not just /models/. .gitattributes sends *.pkl to
# Git LFS, and LFS storage is never reclaimed: the predecessor repo kept a
# 217 MB pickle at scripts/models/ and that copy is billed forever.
*.pkl

/inputs/*
!/inputs/_DIR_EXISTS/
/outputs/*
!/outputs/_DIR_EXISTS/
/sources/*
!/sources/_DIR_EXISTS/
/models/*
!/models/_DIR_EXISTS/
quickstart/*
!quickstart/matts_wordlist.txt
!quickstart/sorted_words/

/wordlist/lib/clues.py
search_config.yml
/tmp